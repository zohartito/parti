<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Parti.Eval.V01</RootNamespace>
    <AssemblyName>Parti.Eval.v01</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Parti.Core\Parti.Core.csproj" />
    <ProjectReference Include="..\..\src\Parti.Core.Grasshopper\Parti.Core.Grasshopper.csproj" />
    <ProjectReference Include="..\..\src\Parti.Providers.Anthropic\Parti.Providers.Anthropic.csproj" />
    <ProjectReference Include="..\..\src\Parti.Providers.Ollama\Parti.Providers.Ollama.csproj" />
    <ProjectReference Include="..\..\src\Parti.Providers.OpenAI\Parti.Providers.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\Parti.Providers.Cli\Parti.Providers.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gated fixtures (top level), live briefs (live/) and deferred fixtures (deferred/, not run). -->
    <None Include="fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Rhino 8.35 component catalog snapshot: the host catalog for every run. -->
    <None Include="..\shared\rhino8-gh-catalog.json" Link="shared\rhino8-gh-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="Never" Condition="Exists('README.md')" />
  </ItemGroup>
</Project>
